<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device-transfer rules. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="com.lingo.app_preferences.xml" />
        <exclude domain="sharedpref" path="lingo_secure_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.lingo.app_preferences.xml" />
        <exclude domain="sharedpref" path="lingo_secure_auth.xml" />
    </device-transfer>
</data-extraction-rules>

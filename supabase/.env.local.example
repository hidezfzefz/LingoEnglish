# Copy to supabase/.env.local and fill in locally. Never commit this file.
# The project URL and anon/publishable key are public app configuration.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: custom SMTP. For Google Workspace use:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=auth@yourdomain.com
#   SMTP_ADMIN_EMAIL=auth@yourdomain.com
#   SMTP_PASS=<16-character Google App Password>
# Or run ./supabase/setup_google_smtp.sh, which prompts securely and tests it.
# Free Gmail works for testing but has low daily sending limits.
# Never commit this file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Lingo
